# --- Optional. The site works fully without any of these. ---

# Supabase (only needed for the in-page admin editor — "System Access" in the footer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form delivery
